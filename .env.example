# Platform Environment Configuration Example
NODE_ENV=production
PORT=3000

# Database (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgres://postgres:postgres@db:5432/ap_evidence
POSTGRES_URI=postgres://postgres:postgres@127.0.0.1:5432/ap_evidence

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=ap-evidence-vault
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# OIDC / JWT Security
JWT_SECRET=AP_INTELLIGENCE_PLATFORM_SECURE_JWT_SECRET_2026_PASS2
JWT_ISSUER=https://keycloak.internal/realms/ap-intelligence
JWT_AUDIENCE=ap-evidence-app
KEYCLOAK_URL=http://localhost:8080

# CORS Security
CORS_ORIGIN=*
