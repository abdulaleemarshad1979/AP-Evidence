# Platform Environment Configuration Example
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/ap_evidence
POSTGRES_URI=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/ap_evidence

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=ap-evidence-vault
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY

# OIDC / JWT Security
JWT_SECRET=YOUR_SECURE_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARACTERS
JWT_ISSUER=https://keycloak.internal/realms/ap-intelligence
JWT_AUDIENCE=ap-evidence-app
KEYCLOAK_URL=http://localhost:8080

# CORS Security
CORS_ORIGIN=http://localhost:3000

